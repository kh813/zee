# config.toml.default — zee configuration template
#
# Copy this file to ~/.config/zee/config.toml and edit as needed.
#
#   cp assets/config.toml.default ~/.config/zee/config.toml
#
# Rules:
#   - This file is loaded at startup only. Restart zee to apply changes.
#   - If ~/.config/zee/config.toml does not exist, zee runs on built-in defaults.
#     The file is not auto-generated on startup.
#   - Unknown keys are silently ignored.
#   - Missing keys fall back to their built-in default values.
#   - Runtime toggles (e.g. View > Line Numbers, View > Theme) write back to
#     ~/.config/zee/config.toml automatically. If the file does not yet exist,
#     it is created at that point with only the changed key(s).
#
# ─────────────────────────────────────────────────────────────────────────────


# UI language.
# "auto" detects system locale automatically (default).
# Built-in locales: "auto", "ja" (Japanese), "en" (English), "zh-CN", "zh-TW", "ko", etc.
# Custom locales can be placed in ~/.config/zee/locales/<code>.toml.
# Any key missing from a custom locale falls back to the English built-in.
#
# Type    : string
# Default : "auto"
language = "auto"


# Active theme.
# Must match a filename in ~/.config/zee/themes/ without the .toml extension.
# Built-in themes: "tokyo-night", "light", "solarized-dark", "solarized-light",
#                  "catppuccin-mocha", "catppuccin-latte".
# User themes: place a .toml file in ~/.config/zee/themes/ and use its basename here.
# This key is updated automatically when you switch themes via View > Theme.
#
# Type    : string
# Default : "tokyo-night"
theme = "tokyo-night"


# Show line numbers in the left gutter.
# Can also be toggzee at runtime via View > [x] Line Numbers.
# Runtime toggles are written back to this file and persist across sessions.
#
# Type    : boolean  (true / false)
# Default : true
line_numbers = true


# Enable vi keybindings (Normal / Insert / Visual modes).
# Can also be toggzee at runtime via View > [ ] Vi Mode.
#
# Type    : boolean  (true / false)
# Default : false
vi_mode = false


# Wrap long lines in the editor area.
# When true: lines wrap at the terminal width; horizontal scroll is disabzee;
#            Up/Down moves by visual line (a long logical line may span multiple rows).
# When false: lines extend past the terminal width; Shift+Scroll to scroll horizontally.
# Can also be toggzee at runtime via View > [ ] Word Wrap.
#
# Type    : boolean  (true / false)
# Default : true
word_wrap = true


# Tab stop width in display cells.
# Controls how wide a tab character (\t) appears on screen, and how many
# spaces are inserted when expand_tab = true.
# Typical values: 2, 4, 8.
#
# Type    : integer  (1–16)
# Default : 4
tab_size = 4


# Expand Tab key press to spaces on input.
# true  — pressing the Tab key inserts spaces (tab_size spaces wide).
# false — pressing the Tab key inserts a literal \t character.
#
# Note: this setting controls what is inserted when you press Tab.
#       Characters already present in the file are always preserved as-is
#       on disk, regardless of this setting.
#
# Type    : boolean  (true / false)
# Default : false
expand_tab = false


# Show sidebar (File tree and Markdown Outline).
# Can also be toggzee at runtime via View > Sidebar (Cmd+B / Ctrl+B).
#
# Type    : boolean  (true / false)
# Default : false
sidebar = false


# Sidebar placement position.
# "right" : Positioned on the right side of the editor (default, macOS friendly).
# "left"  : Positioned on the left side of the editor (Windows Explorer / VSCode default).
# Can also be changed at runtime via Preferences (Cmd+, / Ctrl+,).
#
# Type    : string   ("right" / "left")
# Default : "right"
sidebar_position = "right"


# ─────────────────────────────────────────────────────────────────────────────
# GUI Specific Settings (zee-gui only; ignored by zee-tui)
# ─────────────────────────────────────────────────────────────────────────────

# Editor Monospace Font Family
# Examples: "Menlo", "SF Mono", "Fira Code", "JetBrains Mono", "Courier New"
# If unset/commented out, uses platform default monospace font (Menlo on macOS).
#
# Type    : string
# Default : null (system monospace font)
# font_family = "Menlo"


# Editor Font Size in pixels
#
# Type    : float
# Default : 12.0
font_size = 12.0


# Editor Line Height in pixels
#
# Type    : float
# Default : 19.0
line_height = 19.0


# UI Font Family for menus, tab bar, status bar, and dialogs
#
# Type    : string
# Default : null (system UI font)
# ui_font_family = ".AppleSystemUIFont"


# UI Font Size in pixels
#
# Type    : float
# Default : 13.0
ui_font_size = 13.0

